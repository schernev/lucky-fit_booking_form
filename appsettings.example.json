{
  // Copy this file to appsettings.local.json (same folder) and fill in your values.
  // appsettings.local.json is git-ignored and embedded into the build as the app's default settings.
  // Every field is optional; whatever you omit keeps the built-in value (empty / 14 / true).
  // The user can still change everything later in the app (Настройки).

  // LuckyFit booking widget used by https://www.orangefitness.bg/sofia/grafik
  // e.g. https://orange.lucky.fitness/lessons_form?uuid=...
  "FormUrl": "",

  // Group class to book (case-insensitive)
  "ClassName": "",

  // Optional start time "HH:mm"; empty = any time
  "ClassTime": "",

  // How many days ahead (including today) to look for the next class
  "SearchDays": 14,

  // true = nothing is sent to the site, the app only shows what it would send
  "TestMode": true,

  // Optional default people (each needs its own phone number)
  "Users": [
    { "Selected": true, "FirstName": "", "LastName": "", "Email": "", "Phone": "" }
  ]
}
