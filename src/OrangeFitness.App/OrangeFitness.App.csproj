<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows is built by default. Android is added once the workload is installed:
		     dotnet workload install maui-android   then build with  -p:EnableAndroid=true  (or set it here). -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net11.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(EnableAndroid)' == 'true'">$(TargetFrameworks);net11.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>OrangeFitness.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>



		<!-- Display name -->
		<ApplicationTitle>Orange Fitness Записване</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>bg.orangefitness.register</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Workaround: the WinUI XAML compiler targets (Windows App SDK) look for the MSVC toolset under
	     $(VsInstallRoot)\VC\Tools\MSVC and crash when the C++ workload isn't installed. That path only
	     matters for C++ projects, so pre-setting these properties skips the lookup for this C# app. -->
	<PropertyGroup Condition="'$(VCToolsInstallDir)' == '' and !Exists('$(VsInstallRoot)\VC\Tools\MSVC')">
		<VCInstallPath32>unused</VCInstallPath32>
		<VCInstallPath64>unused</VCInstallPath64>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F57C00" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F57C00" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" BaseSize="222,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OrangeFitness.Core\OrangeFitness.Core.csproj" />
	</ItemGroup>

</Project>
