<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrangeFitness.App.MainPage"
             NavigationPage.HasNavigationBar="False"
             Title="Orange Fitness – записване">
    <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header: centered title -->
    <Label Padding="10,8" Text="Orange Fitness – записване" FontSize="22" FontAttributes="Bold"
           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="20,10,20,20" RowSpacing="14" MaximumWidthRequest="640" VerticalOptions="Start">
        <Label x:Name="ClassLabel" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />

        <VerticalStackLayout Grid.Row="1" x:Name="UsersPanel" Spacing="4" HorizontalOptions="Center" />

        <Label Grid.Row="2" x:Name="TestModeLabel" IsVisible="False" TextColor="DarkOrange" HorizontalTextAlignment="Center"
               Text="ТЕСТОВ РЕЖИМ – нищо няма да се изпрати (изключва се от Настройки)" />

        <Button Grid.Row="3" x:Name="RegisterButton" Text="Запиши за тренировка" FontSize="18" HeightRequest="48" Padding="28,0" HorizontalOptions="Center"
                BackgroundColor="#F57C00" TextColor="White" CornerRadius="10" Clicked="OnRegisterClicked" />

        <!-- Log: hidden until the first registration attempt; capped at ~25 lines (13pt Consolas), scrolls beyond that -->
        <Border Grid.Row="4" x:Name="LogBorder" IsVisible="False" Stroke="LightGray" Padding="10" MaximumHeightRequest="460">
            <ScrollView x:Name="LogScroll">
                <Label x:Name="LogLabel" FontFamily="Consolas" FontSize="13" />
            </ScrollView>
        </Border>
    </Grid>

    <!-- Settings: own row below the form, bottom-right, so it never sits beside the form on narrow screens -->
    <Button Grid.Row="2" Text="Настройки" Clicked="OnSettingsClicked" HorizontalOptions="End" Margin="0,0,10,10"
            BackgroundColor="#E0E0E0" TextColor="#333333" />
    </Grid>
</ContentPage>
